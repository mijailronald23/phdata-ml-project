FROM python:3.10-slim

WORKDIR /app

# Set PYTHONPATH to allow imports from src and within src
ENV PYTHONPATH=/app:/app/src

# Copy and install production dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy and install test dependencies
COPY requirements-test.txt .
RUN pip install --no-cache-dir -r requirements-test.txt

# Copy application code
COPY src ./src
COPY test ./test
COPY pytest.ini .

# Create symlinks for model and data directories to match expected paths
RUN ln -s /app/src/model /app/model && \
    ln -s /app/src/data /app/data

# Default command runs all tests with coverage
CMD ["pytest"]
